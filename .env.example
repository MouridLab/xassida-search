# Required in production and RLS tests
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required server-side in production; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required server-side for the private AutoRAG service
AUTORAG_SERVICE_URL=http://127.0.0.1:8080
AUTORAG_INTERNAL_TOKEN=generate-a-long-random-token
# Optional tuning; keep the shared backend in production
ASK_RATE_LIMIT=10
ASK_RATE_WINDOW_MS=300000
ASK_MAX_CONCURRENCY=4
ASK_TRUST_PROXY=false
ASK_RATE_LIMIT_BACKEND=supabase

# Required in production for private media storage
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=xassida-media
# Optional; keep true for standard MinIO path-style endpoints
MINIO_FORCE_PATH_STYLE=true

# Test-only CI aliases: map these secrets to NEXT_PUBLIC_SUPABASE_* and
# SUPABASE_SERVICE_ROLE_KEY in the RLS job. They must target a test project.
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
