{
  "name": "xassida-search",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:ci": "prettier --check .env.example .eslintrc.json app/api/admin/uploads app/api/admin/editions/route.ts app/api/admin/upload/route.ts app/api/ask/route.ts components/AdminDashboard.tsx docs/audit/FINAL-P1-PRODUCTION-READINESS.md docs/PRODUCTION-BACKUP.md docs/SUPABASE-COMMANDS.md docs/SUPABASE-TEST-SETUP.md lib/api-abuse.ts lib/ask-policy.ts lib/authorization.ts lib/minio.ts lib/shared-rate-limit.ts lib/storage-workflow.ts lib/upload-policy.ts scripts/setup-test-supabase.ts scripts/verify-rls.ts tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "bun --env-file=.env.local scripts/verify-rls.ts",
    "supabase:test:setup": "bun scripts/setup-test-supabase.ts",
    "backup:prod": "env -u SUPABASE_PRODUCTION_DB_URL bun --env-file=.env.local scripts/run-production-backup.ts",
    "backup:verify": "bash scripts/verify-production-backup.sh",
    "supabase:prod:dry-run": "env -u SUPABASE_PRODUCTION_DB_URL -u SUPABASE_PRODUCTION_PROJECT_REF bun --env-file=.env.local scripts/production-migration-dry-run.ts",
    "supabase:prod:apply": "env -u SUPABASE_PRODUCTION_DB_URL -u SUPABASE_PRODUCTION_PROJECT_REF bun --env-file=.env.local scripts/production-migration-apply.ts",
    "catalog:minio:audit": "bun --env-file=.env.local scripts/reconcile-minio-catalog.ts",
    "catalog:minio:unpublish": "bun --env-file=.env.local scripts/reconcile-minio-catalog.ts --apply",
    "import:xassaid": "bun --env-file=.env.local scripts/import-web-khassidas.ts",
    "import:xassaid:apply": "bun --env-file=.env.local scripts/import-web-khassidas.ts --apply",
    "migrate:minio": "bun --env-file=.env.local scripts/migrate-media-to-minio.ts",
    "import:astahfir": "bun --env-file=.env.local scripts/import-astahfir-media.ts",
    "import:jazbul-audio": "bun --env-file=.env.local scripts/import-jazbul-audio.ts",
    "import:library-documents": "bun --env-file=.env.local scripts/import-library-documents.ts",
    "migrate:legacy-covers": "bun --env-file=.env.local scripts/migrate-legacy-covers-to-minio.ts",
    "seed:library": "bun --env-file=.env.local scripts/seed-library.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.28.0",
    "next": "^15.2.4",
    "openai": "^4.89.0",
    "postcss": "^8.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "3.4.17",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.22",
    "prettier": "^3.9.6",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
